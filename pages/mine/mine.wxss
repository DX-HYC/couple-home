.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.profile {
  display: flex;
  align-items: center;
}

.avatar-btn {
  width: 130rpx;
  height: 130rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.nick-display {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  height: 48rpx;
}

.p-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #fff0f3;
  display: block;
}

.ph {
  font-size: 48rpx;
  line-height: 110rpx;
  text-align: center;
}

.p-info {
  flex: 1;
  margin-left: 24rpx;
}

.p-name {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.nick-input {
  background: #f7f7f9;
  border-radius: 14rpx;
  padding: 18rpx 24rpx;
  font-size: 30rpx;
}

.ph {
  color: #ccc;
}

.p-actions {
  display: flex;
  margin-top: 24rpx;
}

.mini-btn {
  display: inline-block;
  font-size: 24rpx;
  color: #ff6b81;
  border: 1rpx solid #ff6b81;
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
  margin-right: 20rpx;
  text-align: center;
}

.mini-btn.plain {
  color: #999;
  border-color: #ddd;
}

.mini-btn.danger {
  color: #ff3b30;
  border-color: #ff3b30;
  display: block;
  margin-right: 0;
  padding: 18rpx 0;
  width: 100%;
}

.avatar-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #ff6b81;
  color: #fff;
  border-radius: 50%;
  font-size: 20rpx;
  border: 3rpx solid #fff;
}

.p-avatar.sm {
  width: 88rpx;
  height: 88rpx;
}

.partner-row {
  display: flex;
  align-items: center;
}

.partner-row .p-info {
  margin-left: 24rpx;
}

.dur-box {
  background: #fff5f7;
  border-radius: 20rpx;
  padding: 28rpx;
  text-align: center;
}

.dur-now {
  font-size: 34rpx;
  font-weight: 600;
  color: #ff6b81;
  font-variant-numeric: tabular-nums;
  margin-bottom: 10rpx;
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #333;
  padding: 6rpx 0;
}

.close-btn {
  margin-top: 20rpx;
}

.unbound {
  line-height: 1.7;
  margin-bottom: 28rpx;
}

.sub {
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.tpl-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
}

.tpl-row:last-of-type {
  border-bottom: none;
}

.tpl-name {
  font-size: 28rpx;
  font-weight: 500;
}

.tpl-state {
  font-size: 24rpx;
  color: #999;
}

.tpl-state.ready {
  color: #34c759;
}

/* 未配置模板时的引导步骤 */
.guide-steps {
  margin-top: 20rpx;
  background: #fff8f6;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
}

.guide-step {
  display: flex;
  align-items: flex-start;
  font-size: 25rpx;
  color: #555;
  line-height: 1.7;
  margin-bottom: 12rpx;
}

.guide-step:last-child {
  margin-bottom: 0;
}

.gs-num {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  background: #ff6b81;
  color: #fff;
  border-radius: 50%;
  font-size: 20rpx;
  margin-right: 12rpx;
  margin-top: 4rpx;
}

.code {
  background: #fff;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 23rpx;
  color: #d9822b;
}

.foot {
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 40rpx;
}
