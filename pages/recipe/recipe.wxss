.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 菜单 */
.order-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
}

.order-row:last-child {
  border-bottom: none;
}

.order-info {
  flex: 1;
  min-width: 0;
}

.order-dish {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.order-status {
  font-size: 20rpx;
  background: #e8f7ed;
  color: #34c759;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 10rpx;
  vertical-align: middle;
}

.order-status.pending {
  background: #fff4e6;
  color: #d9822b;
}

.order-note {
  font-size: 24rpx;
  color: #ff6b81;
  margin-top: 6rpx;
  background: #fff5f7;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
}

.order-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
}

.oa {
  font-size: 24rpx;
  color: #ff6b81;
  margin-bottom: 10rpx;
}

.oa.danger {
  color: #bbb;
}

/* 搜索分类 */
.search-bar {
  padding: 20rpx 24rpx 8rpx;
  position: relative;
}

.search-input {
  background: #fff;
  border-radius: 999rpx;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
}

/* 搜索框右侧的菜谱总数 */
.count-tip {
  position: absolute;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  color: #bbb;
  pointer-events: none;
}

/* 列表底部的分页提示 */
.list-foot {
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  padding: 16rpx 0 40rpx;
}

/* 菜谱来源标注 */
.source-note {
  text-align: center;
  font-size: 20rpx;
  color: #ccc;
  padding: 0 0 40rpx;
}

.ph {
  color: #ccc;
}

.cat-bar {
  white-space: nowrap;
  padding: 16rpx 24rpx 8rpx;
}

.cat {
  display: inline-block;
  padding: 12rpx 30rpx;
  background: #fff;
  color: #666;
  border-radius: 999rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
}

.cat.active {
  background: #ff6b81;
  color: #fff;
}

/* 菜谱卡 */
.recipe-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 129, 0.06);
}

.rc-emoji {
  font-size: 56rpx;
  margin-right: 22rpx;
}

.rc-info {
  flex: 1;
  min-width: 0;
}

.rc-name {
  font-size: 31rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.rc-meta {
  font-size: 22rpx;
}

.rc-ing {
  font-size: 23rpx;
  color: #aaa;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rc-order {
  background: linear-gradient(135deg, #ff6b81, #ff8fab);
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 详情弹层 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 88vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.detail-head {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.d-emoji {
  font-size: 64rpx;
  margin-right: 20rpx;
}

.d-name {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.d-section {
  margin-bottom: 32rpx;
}

.d-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.ing-grid {
  display: flex;
  flex-wrap: wrap;
}

.ing {
  background: #f7f7f9;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 25rpx;
  color: #555;
  margin: 0 14rpx 14rpx 0;
}

.step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.step-num {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #ff6b81;
  color: #fff;
  border-radius: 50%;
  font-size: 22rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.step-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.75;
  color: #444;
}

.tips {
  background: #fff8e6;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  color: #8a6d3b;
  line-height: 1.7;
}

.close-btn {
  margin-top: 20rpx;
}

/* 添加入口 */
.add-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 20rpx;
}

.add-hint {
  font-size: 24rpx;
  color: #999;
}

.add-btn {
  margin: 0;
  flex-shrink: 0;
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 25rpx;
  color: #ff6b81;
  background: #fff5f7;
  border-radius: 30rpx;
}

.add-btn::after {
  border: none;
}

/* 自定义菜谱标签 */
.rc-tag {
  font-size: 18rpx;
  color: #ff6b81;
  background: #ffeef1;
  border-radius: 16rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
  vertical-align: middle;
}

/* 详情页按钮 */
.like-btn {
  background: #fff5f7;
  color: #ff6b81;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 44rpx;
  line-height: 84rpx;
  border: 2rpx solid #ff6b81;
  margin-top: 12rpx;
}

.like-btn::after {
  border: none;
}

.like-btn.liked {
  background: linear-gradient(135deg, #ff8fa3, #ff6b81);
  color: #fff;
}

.danger-btn {
  color: #999;
  background: #f5f5f5;
  border: none;
}

/* 底部表单（与喜好页一致） */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
  z-index: 100;
  max-height: 88vh;
  overflow-y: auto;
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
}

.sheet-close {
  font-size: 30rpx;
  color: #bbb;
  padding: 8rpx;
}

.form-row {
  margin-bottom: 26rpx;
}

.row2 {
  display: flex;
  gap: 24rpx;
}

.row2 .half {
  flex: 1;
}

.form-label {
  display: block;
  font-size: 25rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  background: #f7f7f8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
  box-sizing: border-box;
}

.form-input.area {
  height: 140rpx;
  line-height: 1.5;
}

.ph {
  color: #bbb;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  background: #f2f2f4;
  color: #666;
  border: 2rpx solid transparent;
}

.chip.sel {
  background: #ffeef1;
  color: #ff6b81;
  border-color: #ff6b81;
  font-weight: 500;
}

.primary-btn {
  background: linear-gradient(135deg, #ff8fa3, #ff6b81);
  color: #fff;
  font-size: 29rpx;
  font-weight: 500;
  border-radius: 44rpx;
  line-height: 88rpx;
  border: none;
  margin-top: 12rpx;
}

.primary-btn::after {
  border: none;
}

.ghost-btn {
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 44rpx;
  line-height: 84rpx;
  border: none;
  margin-top: 12rpx;
}

.ghost-btn::after {
  border: none;
}
