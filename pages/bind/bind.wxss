.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.tabs {
  display: flex;
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #999;
}

.tab.active {
  background: #ff6b81;
  color: #fff;
  font-weight: 500;
}

.desc {
  line-height: 1.7;
  margin-bottom: 28rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #333;
  padding: 6rpx 0;
}

.time-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
}

.invite-result {
  background: #fff5f7;
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  margin-bottom: 28rpx;
}

.invite-label {
  font-size: 24rpx;
  color: #999;
}

.invite-code {
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: #ff6b81;
  margin: 12rpx 0;
}

.code-input {
  letter-spacing: 8rpx;
  font-weight: 600;
  font-size: 36rpx;
}

.ph {
  color: #ccc;
  letter-spacing: 4rpx;
  font-weight: 400;
}

.share-btn {
  margin-top: 20rpx;
}

.center-tip {
  text-align: center;
  margin-top: 24rpx;
  text-decoration: underline;
}

.notice {
  margin: 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
}

.notice-title {
  font-size: 27rpx;
  color: #666;
  font-weight: 600;
  margin-bottom: 10rpx;
}
