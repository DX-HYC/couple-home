.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 140rpx;
  background: linear-gradient(180deg, #fff5f7 0%, #fff 30%);
}

/* ---------- 统计条 ---------- */
.stat-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #ff6b81;
  line-height: 1;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-sep {
  width: 1rpx;
  height: 48rpx;
  background: #f0f0f0;
}

/* ---------- 卡片 ---------- */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.card-title::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  background: #ff6b81;
  border-radius: 3rpx;
  margin-right: 12rpx;
}

/* ---------- 愿望条目 ---------- */
.wish-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.wish-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

/* 已实现的整行淡出 */
.wish-row.done .wish-title {
  color: #aaa;
  text-decoration: line-through;
}

.check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #ffc2cd;
  color: #ff6b81;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.check.checked {
  background: #ff6b81;
  border-color: #ff6b81;
  color: #fff;
  font-size: 26rpx;
}

.wish-body {
  flex: 1;
  min-width: 0;
}

.wish-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.5;
  word-break: break-all;
}

.w-emoji {
  margin-right: 8rpx;
}

.wish-detail {
  font-size: 23rpx;
  color: #888;
  line-height: 1.5;
  margin-top: 6rpx;
}

.wish-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.w-tag {
  font-size: 21rpx;
  color: #999;
  background: #f5f5f7;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
}

.w-tag.mine {
  color: #ff6b81;
  background: #ffeef1;
}

.w-date {
  font-size: 21rpx;
  color: #bbb;
}

.wish-acts {
  flex-shrink: 0;
  display: flex;
  gap: 6rpx;
  margin-left: 12rpx;
}

.pact {
  font-size: 22rpx;
  color: #ff6b81;
  padding: 6rpx 12rpx;
  background: #fff5f7;
  border-radius: 20rpx;
}

.pact.danger {
  color: #aaa;
  background: #f5f5f5;
}

/* ---------- 空状态 ---------- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 90rpx 40rpx;
  text-align: center;
}

.empty-ico {
  font-size: 84rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 32rpx;
  white-space: pre-line;
}

/* ---------- 悬浮按钮 ---------- */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8fa3, #ff6b81);
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(255, 107, 129, 0.38);
  border: none;
  line-height: 1;
  padding: 0;
  z-index: 50;
}

.fab::after {
  border: none;
}

/* ---------- 底部表单 ---------- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
  z-index: 100;
  max-height: 88vh;
  overflow-y: auto;
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0%); }
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
}

.sheet-close {
  font-size: 30rpx;
  color: #bbb;
  padding: 8rpx;
}

.form-row {
  margin-bottom: 26rpx;
}

.form-label {
  display: block;
  font-size: 25rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  background: #f7f7f8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
  box-sizing: border-box;
}

.form-input.area {
  height: 140rpx;
  line-height: 1.5;
}

.ph {
  color: #bbb;
}

.date-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-picker-wrap {
  flex: 1;
  min-width: 0;
}

.date-box {
  color: #333;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  background: #f2f2f4;
  color: #666;
  border: 2rpx solid transparent;
}

.chip.sel {
  background: #ffeef1;
  color: #ff6b81;
  border-color: #ff6b81;
  font-weight: 500;
}

.primary-btn {
  background: linear-gradient(135deg, #ff8fa3, #ff6b81);
  color: #fff;
  font-size: 29rpx;
  font-weight: 500;
  border-radius: 44rpx;
  line-height: 88rpx;
  border: none;
  margin-top: 12rpx;
}

.primary-btn::after {
  border: none;
}
