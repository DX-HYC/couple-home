.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.hint {
  background: #fff4e6;
  color: #d9822b;
  font-size: 24rpx;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hint-text {
  flex: 1;
}

.hint-act {
  flex-shrink: 0;
  color: #ff6b81;
  font-weight: 600;
  text-decoration: underline;
}

.loc-row {
  display: flex;
  align-items: center;
}

.loc-emoji {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.loc-info {
  flex: 1;
  min-width: 0;
}

.loc-text {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
  word-break: break-all;
}

.loc-text.pending {
  color: #b8860b;
  font-size: 26rpx;
}

.link {
  color: #ff6b81;
  text-decoration: underline;
}

.place-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
  background: #fff8e6;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  line-height: 1.6;
}

.loc-open {
  font-size: 24rpx;
  color: #ff6b81;
  margin-left: 12rpx;
  white-space: nowrap;
}

.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.bar-text {
  font-size: 24rpx;
  color: #34c759;
}

.bar-text.off {
  color: #bbb;
}

.bar-sync {
  font-size: 22rpx;
  color: #bbb;
}

.bar-actions {
  display: flex;
  margin-top: 20rpx;
}

.mini-btn {
  font-size: 24rpx;
  color: #ff6b81;
  border: 1rpx solid #ff6b81;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  margin-right: 20rpx;
}

.distance-card {
  text-align: center;
  background: linear-gradient(135deg, #fff0f3, #fff);
}

.distance-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff6b81;
  margin-bottom: 12rpx;
}

.update-time {
  margin-top: 16rpx;
}

.empty-sm {
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
  padding: 40rpx 20rpx;
  line-height: 1.7;
}

.privacy {
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #aaa;
  line-height: 1.8;
}
