.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.diary-card {
  padding: 28rpx;
}

.head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ff6b81;
}

.ph-avatar {
  color: #fff;
  font-size: 24rpx;
  line-height: 72rpx;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
}

.head-info {
  flex: 1;
  margin-left: 20rpx;
}

.who {
  font-size: 28rpx;
  font-weight: 600;
}

.mine-tag {
  font-size: 20rpx;
  background: #fff0f3;
  color: #ff6b81;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}

.time {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.del {
  font-size: 24rpx;
  color: #ff3b30;
}

.content {
  font-size: 29rpx;
  line-height: 1.75;
  color: #333;
  white-space: pre-wrap;
}

/* 日记图片：每行 3 张
 *
 * ⚠️ 这里刻意只用最基础的一套写法（百分比宽度 + border-box + 普通流），
 *    不要改成 calc() 撑高度 + 绝对定位那套：
 *    那样容器高度算不出来，图片会溢出卡片、卡片也不被撑开。
 *
 * 宽度：33.33% 三格 = 99.99%，不会因浮点误差把第 3 张挤到下一行；
 *      水平间距靠格子自己的 padding-right（border-box 内含），
 *      .images 上 margin-right:-12rpx 抵消最后一格的间距，右边缘与正文齐平。
 * 高度：直接给固定值，图片在普通流里，容器高度能正确撑开卡片。
 */
.images {
  display: flex;
  flex-wrap: wrap;
  margin-right: -12rpx;
  margin-top: 20rpx;
}

.img-wrap {
  position: relative;
  width: 33.33%;
  box-sizing: border-box;
  padding-right: 12rpx;
  margin-bottom: 12rpx;
}

.diary-img {
  width: 100%;
  height: 202rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  display: block;
}

.img-failed {
  position: absolute;
  left: 0;
  top: 0;
  right: 12rpx;
  height: 202rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 1.6;
  padding: 10rpx;
  box-sizing: border-box;
}

.loc {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #666;
}

.add-btn {
  margin: 32rpx 24rpx 0;
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 88vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  background: #f7f7f9;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 30rpx;
  line-height: 1.7;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}

.ph {
  color: #bbb;
}

.picker-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.picker-label {
  font-size: 26rpx;
  color: #666;
  width: 80rpx;
}

.opt {
  font-size: 38rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  margin-right: 8rpx;
  opacity: 0.4;
}

.opt.sel {
  opacity: 1;
  background: #fff0f3;
}

.opt.add {
  font-size: 26rpx;
  opacity: 1;
  background: #f7f7f9;
  color: #666;
}

.loc-pick {
  margin-bottom: 24rpx;
}

.loc-set {
  font-size: 26rpx;
  color: #ff6b81;
}

.clear {
  color: #999;
  text-decoration: underline;
}

.loc-none {
  font-size: 26rpx;
  color: #999;
  text-decoration: underline;
}

/* 发布弹层里的图片选择网格：与正文图片同一套 3 列写法 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  margin-right: -12rpx;
  margin-bottom: 24rpx;
}

.img-box {
  position: relative;
  width: 33.33%;
  box-sizing: border-box;
  padding-right: 12rpx;
  margin-bottom: 12rpx;
}

.img {
  width: 100%;
  height: 214rpx;
  border-radius: 12rpx;
}

.img-del {
  position: absolute;
  top: -6rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  background: #333;
  color: #fff;
  border-radius: 50%;
  font-size: 30rpx;
}

.close-btn {
  margin-top: 20rpx;
}
