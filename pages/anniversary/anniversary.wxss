.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.anniv-card {
  padding: 28rpx;
}

.row {
  display: flex;
  align-items: flex-start;
}

.emoji {
  font-size: 52rpx;
  margin-right: 20rpx;
  line-height: 1.2;
}

.info {
  flex: 1;
  min-width: 0;
}

.title-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.target {
  font-size: 24rpx;
  color: #ff6b81;
  margin: 8rpx 0 4rpx;
}

.days-box {
  text-align: right;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.days {
  text-align: right;
}

.num {
  font-size: 52rpx;
  font-weight: 700;
  color: #ff6b81;
  line-height: 1;
}

.num.today {
  font-size: 34rpx;
}

.unit {
  font-size: 22rpx;
  color: #ff6b81;
  margin-left: 4rpx;
}

/* 时分秒：作为天数的补充说明，不抢主视觉 */
.hms {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
}

.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action {
  font-size: 26rpx;
  color: #999;
  margin-left: 32rpx;
}

.action.danger {
  color: #ff3b30;
}

.add-btn {
  margin: 32rpx 24rpx 0;
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 86vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 28rpx;
}

.ph {
  color: #ccc;
}

.emoji-row {
  display: flex;
  flex-wrap: wrap;
}

.emoji-opt {
  font-size: 44rpx;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  line-height: 1.2;
  opacity: 0.45;
}

.emoji-opt.sel {
  opacity: 1;
  background: #fff0f3;
}

.type-row {
  display: flex;
  flex-wrap: wrap;
}

.type-opt {
  padding: 14rpx 28rpx;
  background: #f7f7f9;
  border-radius: 999rpx;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.type-opt.sel {
  background: #ff6b81;
  color: #fff;
}

.scroll-row {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 12rpx 20rpx;
  background: #f7f7f9;
  border-radius: 12rpx;
  margin: 0 12rpx 12rpx 0;
  font-size: 26rpx;
  color: #666;
  min-width: 68rpx;
  text-align: center;
}

.chip.sel {
  background: #ff6b81;
  color: #fff;
}

.year-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.year-text {
  font-size: 40rpx;
  font-weight: 600;
  margin: 0 32rpx;
  min-width: 140rpx;
  text-align: center;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
}

.close-btn {
  margin-top: 20rpx;
}
