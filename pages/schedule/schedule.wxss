.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 140rpx;
  background: linear-gradient(180deg, #fff5f7 0%, #fff 30%);
}

/* ---------- 今日卡片 ---------- */
.today-card {
  background: linear-gradient(135deg, #ff8fa3 0%, #ff6b81 60%, #ff8095 100%);
  border-radius: 26rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 129, 0.2);
}

.today-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.today-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.today-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.today-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 18rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
}

.today-item:last-child {
  margin-bottom: 0;
}

.td-time {
  width: 120rpx;
  flex-shrink: 0;
}

.td-hhmm {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.td-remain {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.td-remain.done {
  color: rgba(255, 255, 255, 0.6);
}

.td-body {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
}

.td-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.td-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.td-note {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
  line-height: 1.4;
}

.td-check {
  flex-shrink: 0;
}

/* ---------- 卡片与列表 ---------- */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.card-title::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  background: #ff6b81;
  border-radius: 3rpx;
  margin-right: 12rpx;
}

.sch-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.sch-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.sch-row.done .sch-title {
  color: #bbb;
  text-decoration: line-through;
}

.sch-check {
  flex-shrink: 0;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.check-ico {
  font-size: 40rpx;
}

.sch-body {
  flex: 1;
  min-width: 0;
}

.sch-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.sch-when {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.sch-date {
  font-size: 24rpx;
  color: #ff6b81;
  font-weight: 500;
}

.sch-note {
  font-size: 23rpx;
  color: #888;
  line-height: 1.5;
  margin-top: 6rpx;
}

.sch-owner {
  font-size: 21rpx;
  margin-top: 8rpx;
}

.sch-acts {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.act {
  font-size: 24rpx;
  color: #ff6b81;
  padding: 6rpx 12rpx;
}

.act.danger {
  color: #bbb;
}

/* ---------- 标签 ---------- */
.tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: #f2f2f2;
  color: #777;
}

.t-urgent {
  background: #ffeaea;
  color: #e0435f;
}

.t-high {
  background: #fff3e6;
  color: #d9822b;
}

.t-normal {
  background: #eef4ff;
  color: #5b7ec2;
}

.t-cat {
  background: #f0f0f0;
  color: #666;
}

.t-rep {
  background: #eaf7ef;
  color: #3f9d68;
}

/* ---------- 空状态 ---------- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-ico {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

/* ---------- 悬浮按钮 ---------- */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8fa3, #ff6b81);
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(255, 107, 129, 0.38);
  border: none;
  line-height: 1;
  padding: 0;
  z-index: 50;
}

.fab::after {
  border: none;
}

/* ---------- 底部表单 ---------- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
  z-index: 100;
  max-height: 88vh;
  overflow-y: auto;
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
}

.sheet-close {
  font-size: 30rpx;
  color: #bbb;
  padding: 8rpx;
}

.form-row {
  margin-bottom: 26rpx;
}

.form-label {
  display: block;
  font-size: 25rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  background: #f7f7f8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
  box-sizing: border-box;
}

.form-input.area {
  height: 140rpx;
  line-height: 1.5;
}

.ph {
  color: #bbb;
}

.form-picker {
  background: #f7f7f8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
  color: #333;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  background: #f2f2f4;
  color: #666;
  border: 2rpx solid transparent;
}

.chip.sel {
  background: #ffeef1;
  color: #ff6b81;
  border-color: #ff6b81;
  font-weight: 500;
}

.primary-btn {
  background: linear-gradient(135deg, #ff8fa3, #ff6b81);
  color: #fff;
  font-size: 29rpx;
  font-weight: 500;
  border-radius: 44rpx;
  line-height: 88rpx;
  border: none;
  margin-top: 12rpx;
}

.primary-btn::after {
  border: none;
}

.muted {
  color: #999;
  font-size: 22rpx;
}
