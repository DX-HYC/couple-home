page {
  background: #fff5f7;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #333;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 129, 0.08);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.muted {
  color: #999;
  font-size: 24rpx;
}

.primary-btn {
  background: linear-gradient(135deg, #ff6b81, #ff8fab);
  color: #fff;
  border-radius: 999rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 1.4;
}

.primary-btn::after {
  border: none;
}

.ghost-btn {
  background: #fff;
  color: #ff6b81;
  border: 2rpx solid #ff6b81;
  border-radius: 999rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.4;
}

.ghost-btn::after {
  border: none;
}

.disabled-btn {
  background: #e0e0e0 !important;
  color: #fff !important;
}

.field {
  background: #f7f7f9;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.field-input {
  font-size: 30rpx;
  color: #333;
  width: 100%;
}

.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #fff0f3;
  color: #ff6b81;
  margin-right: 12rpx;
}

.empty {
  text-align: center;
  color: #bbb;
  padding: 100rpx 0;
  font-size: 26rpx;
}

.locked-tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 40rpx 0;
}
